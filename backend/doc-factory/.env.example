# =============================================================================
# Documentation AI Factory — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Required API keys -------------------------------------------------------

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Tavily Search API key (https://tavily.com/)
TAVILY_API_KEY=

# --- Gemini model configuration (optional) -----------------------------------

# Fast model for intake, query planning, and synthesis
DOC_FACTORY_GEMINI_MODEL_FLASH=gemini-2.0-flash

# Capable model for long-form section generation
DOC_FACTORY_GEMINI_MODEL_PRO=gemini-2.5-pro

# --- Paths (optional — defaults resolve relative to repo root) ---------------

# Architecture Space repository root (parent of documentation_ai_factory/)
# DOC_FACTORY_REPO_ROOT=

# Factory project root (defaults to directory containing pyproject.toml)
# DOC_FACTORY_PROJECT_ROOT=

# Staging output directory (defaults to documentation_ai_factory/output/)
# DOC_FACTORY_OUTPUT_DIR=

# Run artifacts directory (defaults to documentation_ai_factory/runs/)
# DOC_FACTORY_RUNS_DIR=

# --- Research settings (optional) --------------------------------------------

DOC_FACTORY_TAVILY_MAX_RESULTS=5
DOC_FACTORY_TAVILY_DEEP_MAX_RESULTS=10
DOC_FACTORY_TAVILY_DEEP_MAX_QUERIES=8
DOC_FACTORY_TAVILY_DEEP_EXTRACT_URLS=3
DOC_FACTORY_TAVILY_SNIPPET_MAX_CHARS=4000
DOC_FACTORY_RESEARCH_CACHE_TTL_DAYS=7
DOC_FACTORY_RESEARCH_QUERY_COUNT=10

# --- Generation settings (optional) --------------------------------------------

DOC_FACTORY_MAX_PARALLEL_SECTIONS=4
DOC_FACTORY_MIN_SECTION_WORDS=400

# --- Logging (optional) ------------------------------------------------------

DOC_FACTORY_LOG_LEVEL=INFO
# DOC_FACTORY_LOG_FILE=

# --- ADK (optional) ----------------------------------------------------------

# Used by ADK when serving agents via `adk web`
GOOGLE_API_KEY=
