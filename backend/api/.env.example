# =============================================================================
# KEW API — Environment Variables
# Copy to Architecture_space/.env (monorepo root) or services/api/.env
# =============================================================================

# --- Environment -------------------------------------------------------------

# development | staging | production
KEW_API_ENVIRONMENT=development

# Enable debug mode (auto-disabled in production)
# KEW_API_DEBUG=true

# --- Server ------------------------------------------------------------------

KEW_API_HOST=127.0.0.1
KEW_API_PORT=8000

# Hot reload (development only; disabled when ENVIRONMENT=production)
KEW_API_RELOAD=true

# Uvicorn worker processes (production)
KEW_API_WORKERS=1

# --- HTTP / CORS -------------------------------------------------------------

# Comma-separated allowed origins for the Vite dev server / workbench
KEW_API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

KEW_API_API_V1_PREFIX=/api/v1
KEW_API_WS_PREFIX=/ws
KEW_API_WS_PING_INTERVAL_SECONDS=30

# --- Paths (optional — defaults resolve from monorepo root) ------------------

# KEW_API_REPO_ROOT=
# KEW_API_DOCS_ROOT=
# KEW_API_DATA_ROOT=

# --- Logging -----------------------------------------------------------------

KEW_API_LOG_LEVEL=INFO

# Optional explicit log file (default: .data/logs/api.log in production)
# KEW_API_LOG_FILE=

# Emit JSON log lines (default: true in production)
# KEW_API_LOG_JSON=false

# --- Errors ------------------------------------------------------------------

# Include exception details in API error payloads (default: false in production)
# KEW_API_EXPOSE_ERROR_DETAILS=true

# --- Custom dotenv location (optional) -----------------------------------------

# KEW_ENV_FILE=C:\path\to\.env

# --- Engine keys (shared with doc_factory — set at monorepo root) ------------

# GEMINI_API_KEY=

# Use mock AI responses without calling Gemini (development / tests)
# KEW_API_AI_MOCK_MODE=true
# TAVILY_API_KEY=
# DOC_FACTORY_REPO_ROOT=
