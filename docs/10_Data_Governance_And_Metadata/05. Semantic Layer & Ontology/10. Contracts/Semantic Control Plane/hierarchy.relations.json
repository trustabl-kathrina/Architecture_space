      "Federation Edge",
      "Concept (global)"
    ]
  },
  "relations": [
    {
      "id": "rel-ns-contains-concept",
      "from": "Namespace",
      "predicate": "contains",
      "to": "Concept",
      "public_id": "NamespaceContainsConcept",
      "normative": true
    },
    {
      "id": "rel-mapping-targets-concept",
      "from": "Mapping Record",
      "predicate": "targets",
      "to": "Concept",
      "public_id": "MappingRecordTargetsConcept",
