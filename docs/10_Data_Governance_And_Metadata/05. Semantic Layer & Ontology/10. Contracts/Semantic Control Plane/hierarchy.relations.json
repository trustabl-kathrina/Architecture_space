  "doc": "01. Hierarchy And Relations.md",
  "canonical_chains": {
    "registry": [
      "Namespace",
      "Concept"
    ],
    "mapping": [
      "Catalog/Marketplace asset",
      "Mapping Record",
      "Concept"
