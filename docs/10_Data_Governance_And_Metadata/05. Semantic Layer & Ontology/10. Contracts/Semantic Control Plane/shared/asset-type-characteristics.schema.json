{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entropy.example/schemas/semantic-control-plane/asset-type-characteristics.schema.json",
  "title": "Semantic Control Plane Type Contract",
  "type": "object",
  "required": [
    "contract_id",
    "version",
    "status",
    "asset_type",
    "kind",
    "characteristics"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "pattern": "^ctr-scp-"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "Namespace",
        "Concept",
        "Mapping Record",
        "Federation Edge"
      ]
    },
    "kind": {
      "type": "string",
      "const": "asset_type_characteristics"
    },
    "characteristics": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
