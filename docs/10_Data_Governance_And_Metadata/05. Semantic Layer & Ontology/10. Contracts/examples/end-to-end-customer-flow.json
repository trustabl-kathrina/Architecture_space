{
  "meta": {
    "title": "End-to-End Customer 360 — Cross-Pack Flow",
    "scenario": "Publish Customer 360 with aligned business, technical, product, and control-plane meaning",
    "cross_pack_contract": "ctr-cross-pack-relations-v1",
    "doc": "01. Cross-Pack Relationships And Flow.md"
  },
  "control_plane": {
    "namespace": {
      "id": "ns-global",
      "slug": "global",
      "naming": "tmforum-sid",
      "example": "Semantic Control Plane/Namespace/example.json",
      "catalog": "Semantic Control Plane/Namespace/examples/namespaces.json"
    },
    "natco_namespaces": [
      "ns-natco-de",
      "ns-natco-at",
      "ns-natco-hr",
      "ns-natco-hu",
      "ns-natco-pl"
    ],
    "concepts": [
      {
        "id": "concept-global-Customer",
        "uri": "https://semantics.example/ns/global/Customer",
        "kind": "entity",
        "label": "Customer",
        "naming": "tmforum-sid",
        "example": "Semantic Control Plane/Concept/example.json"
      },
      {
        "id": "concept-global-CustomerIdentification",
        "uri": "https://semantics.example/ns/global/CustomerIdentification",
        "kind": "shared_property",
        "label": "Customer Identification",
        "naming": "tmforum-sid"
      }
    ],
    "multi_natco": "Semantic Control Plane/examples/multi-natco-customer.json"
  },
  "steps": [
    {
      "step": 1,
      "pack": "semantic-control-plane",
      "action": "Approve concepts in global namespace",
      "objects": ["concept-global-Customer", "concept-global-CustomerIdentification"]
    },
    {
      "step": 2,
      "pack": "business-catalog",
      "action": "Create glossary and logical model",
      "objects": [
        {
          "id": "asset-term-customer",
          "type": "Business Term",
          "example": "Business Catalog/Business Term/example.json"
        },
        {
          "id": "asset-domain-customer",
          "type": "Data Domain",
          "example": "Business Catalog/Data Domain/example.json"
        },
        {
          "id": "asset-entity-customer",
          "type": "Data Entity",
          "example": "Business Catalog/Data Entity/example.json"
        },
        {
          "id": "asset-attr-customer-id",
          "type": "Data Attribute",
          "example": "Business Catalog/Data Attribute/example.json"
        }
      ]
    },
    {
      "step": 3,
      "pack": "semantic-control-plane",
      "action": "DA-08 mapsTo mappings",
      "relations": [
        {
          "id": "X1",
          "from": "asset-term-customer",
          "predicate": "mapsTo",
          "to": "concept-global-Customer",
          "mapping_record": "map-biz-de-customer-001"
        },
        {
          "id": "X3",
          "from": "asset-entity-customer",
          "predicate": "mapsTo",
          "to": "concept-global-Customer"
        },
        {
          "id": "X4",
          "from": "asset-attr-customer-id",
          "predicate": "mapsTo",
          "to": "concept-global-CustomerIdentification"
        }
      ]
    },
    {
      "step": 4,
      "pack": "technical-catalog",
      "action": "Ingest physical hierarchy",
      "objects": [
        {
          "id": "asset-db-crm",
          "type": "Database",
          "example": "Technical Catalog/Database/example.json"
        },
        {
          "id": "asset-sch-crm",
          "type": "Schema",
          "example": "Technical Catalog/Schema/example.json"
        },
        {
          "id": "asset-tbl-customer",
          "type": "Table",
          "name": "crm.customer",
          "example": "Technical Catalog/Table/example.json"
        },
        {
          "id": "asset-col-party-id",
          "type": "Column",
          "name": "party_id",
          "example": "Technical Catalog/Column/example.json"
        }
      ],
      "containment": [
        "asset-db-crm -has-> asset-sch-crm -contains-> asset-tbl-customer -contains-> asset-col-party-id"
      ]
    },
    {
      "step": 5,
      "pack": "cross",
      "action": "Structural bridge business ↔ technical",
      "relations": [
        {
          "id": "X14",
          "from": "asset-entity-customer",
          "predicate": "implemented_in",
          "to": "asset-tbl-customer"
        },
        {
          "id": "X15",
          "from": "asset-attr-customer-id",
          "predicate": "implemented_in",
          "to": "asset-col-party-id"
        }
      ]
    },
    {
      "step": 6,
      "pack": "semantic-control-plane",
      "action": "DA-09 represents mappings",
      "relations": [
        {
          "id": "X7",
          "from": "asset-tbl-customer",
          "predicate": "represents",
          "to": "concept-global-Customer"
        },
        {
          "id": "X8",
          "from": "asset-col-party-id",
          "predicate": "represents",
          "to": "concept-global-CustomerIdentification"
        }
      ]
    },
    {
      "step": 7,
      "pack": "data-products",
      "action": "Publish product, port, ODCS contract",
      "objects": [
        {
          "id": "asset-dp-customer-360",
          "type": "Data Product",
          "example": "Data Products/Data Product/example.json"
        },
        {
          "id": "asset-port-c360-out",
          "type": "Data Product Output Port",
          "example": "Data Products/Data Product Output Port/example.json"
        },
        {
          "id": "asset-contract-c360",
          "type": "Data Contract",
          "example": "Data Products/Data Contract/example.json"
        },
        {
          "id": "asset-cf-customer-id",
          "type": "Contract Field",
          "example": "Data Products/Contract Field/example.json"
        }
      ]
    },
    {
      "step": 8,
      "pack": "cross",
      "action": "Product ↔ technical implementation",
      "relations": [
        {
          "id": "X16",
          "from": "asset-port-c360-out",
          "predicate": "implemented_by",
          "to": "asset-tbl-c360",
          "note": "Curated hub table dp.customer_360"
        },
        {
          "id": "X17",
          "from": "asset-cf-customer-id",
          "predicate": "implemented_by",
          "to": "asset-col-c360-customer-id"
        },
        {
          "id": "X18",
          "from": "asset-dp-customer-360",
          "predicate": "relates_to",
          "to": "asset-domain-customer"
        }
      ]
    },
    {
      "step": 9,
      "pack": "semantic-control-plane",
      "action": "DA-10 implements mappings",
      "relations": [
        {
          "id": "X11",
          "from": "asset-dp-customer-360",
          "predicate": "implements",
          "to": "concept-global-Customer"
        },
        {
          "id": "X13",
          "from": "asset-cf-customer-id",
          "predicate": "implements",
          "to": "concept-global-CustomerIdentification"
        }
      ]
    },
    {
      "step": 10,
      "pack": "consumer",
      "action": "Discover product and resolve meaning",
      "queries": [
        "What concept does global-customer-360 implement? → global/customer",
        "Which business terms map to that concept?",
        "Which source tables represent that concept?",
        "Which contract fields implement customer-identifier?"
      ]
    }
  ],
  "convergence": {
    "concept_uri": "https://semantics.example/ns/global/Customer",
    "tmforum_sid": "Customer",
    "aligned": [
      { "pack": "business-catalog", "predicate": "mapsTo", "objects": ["asset-term-customer", "asset-entity-customer"] },
      { "pack": "technical-catalog", "predicate": "represents", "objects": ["asset-tbl-customer"] },
      { "pack": "data-products", "predicate": "implements", "objects": ["asset-dp-customer-360"] }
    ],
    "federation": [
      { "from": "natco-de/kunde", "to": "global/Customer" },
      { "from": "natco-at/kunde", "to": "global/Customer" },
      { "from": "natco-hr/kupac", "to": "global/Customer" },
      { "from": "natco-hu/ugyfel", "to": "global/Customer" },
      { "from": "natco-pl/klient", "to": "global/Customer" }
    ]
  }
}
