// 00-constraints.cypher — uniqueness for Contracts KG POC
CREATE CONSTRAINT namespace_id IF NOT EXISTS FOR (n:Namespace) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT concept_id IF NOT EXISTS FOR (c:Concept) REQUIRE c.id IS UNIQUE;
CREATE CONSTRAINT concept_uri IF NOT EXISTS FOR (c:Concept) REQUIRE c.uri IS UNIQUE;
CREATE CONSTRAINT mapping_id IF NOT EXISTS FOR (m:MappingRecord) REQUIRE m.id IS UNIQUE;
CREATE CONSTRAINT federation_id IF NOT EXISTS FOR (f:FederationEdge) REQUIRE f.id IS UNIQUE;
CREATE CONSTRAINT business_term_id IF NOT EXISTS FOR (t:BusinessTerm) REQUIRE t.id IS UNIQUE;
CREATE CONSTRAINT data_domain_id IF NOT EXISTS FOR (d:DataDomain) REQUIRE d.id IS UNIQUE;
CREATE CONSTRAINT data_entity_id IF NOT EXISTS FOR (e:DataEntity) REQUIRE e.id IS UNIQUE;
CREATE CONSTRAINT data_attribute_id IF NOT EXISTS FOR (a:DataAttribute) REQUIRE a.id IS UNIQUE;
CREATE CONSTRAINT data_model_id IF NOT EXISTS FOR (m:DataModel) REQUIRE m.id IS UNIQUE;
CREATE CONSTRAINT data_concept_id IF NOT EXISTS FOR (c:DataConcept) REQUIRE c.id IS UNIQUE;
CREATE CONSTRAINT system_id IF NOT EXISTS FOR (s:System) REQUIRE s.id IS UNIQUE;
CREATE CONSTRAINT database_id IF NOT EXISTS FOR (d:Database) REQUIRE d.id IS UNIQUE;
CREATE CONSTRAINT schema_id IF NOT EXISTS FOR (s:Schema) REQUIRE s.id IS UNIQUE;
CREATE CONSTRAINT table_id IF NOT EXISTS FOR (t:Table) REQUIRE t.id IS UNIQUE;
CREATE CONSTRAINT column_id IF NOT EXISTS FOR (c:Column) REQUIRE c.id IS UNIQUE;
CREATE CONSTRAINT data_product_id IF NOT EXISTS FOR (p:DataProduct) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT output_port_id IF NOT EXISTS FOR (p:OutputPort) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT input_port_id IF NOT EXISTS FOR (p:InputPort) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT data_contract_id IF NOT EXISTS FOR (c:DataContract) REQUIRE c.id IS UNIQUE;
CREATE CONSTRAINT contract_field_id IF NOT EXISTS FOR (f:ContractField) REQUIRE f.id IS UNIQUE;
