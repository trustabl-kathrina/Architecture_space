  "governanceExample": {
    "concept": "global/customer",
    "sid": "Customer · Customer Party Roles ABE",
    "steps": [
      { "state": "draft", "actor": "Data Architecture", "action": "Import from SID into import-tmforum; promote stub to global" },
      { "state": "review", "actor": "Global Customer steward", "action": "Submit for COE approval with SID annotations" },
      { "state": "approved", "actor": "Global Semantic Council", "action": "Approve — valid target for maps and product binds" },
      { "state": "deprecated", "actor": "COE", "action": "Only with replaced_by + NATCO notification SLA" }
    ]
  },
  "apiExamples": [
    {
      "api": "Semantic API",
      "call": "GET /concepts/global/customer",
      "result": "SID Customer definition, URI, status=approved, synonyms"
    },
    {
      "api": "Semantic API",
      "call": "POST /resolve { term: 'Kunde', natco: 'de' }",
      "result": "→ natco-de/kunden —sameAs→ global/customer"
    },
    {
      "api": "Graph API",
      "call": "GET /graph/neighbors/global/customer?depth=2",
      "result": "owns Account · obtains Product · realizedAs CFS"
    },
    {
      "api": "Search API",
      "call": "GET /search?q=ProductOffering&ns=global",
      "result": "SID Product Offering + mapped Collibra 'Angebot'"
    },
    {
      "api": "MCP Server",
      "call": "tool: semantic.lookup('customer-facing-service')",
      "result": "Certified URI + CFS definition for agent context"
    },
    {
      "api": "Ossie export",
      "call": "GET /ossie/global/versions/1.0.0",
      "result": "Package: Tier A SID concepts + ontology edges"
    }
  ],
  "engineExamples": {
    "registry": {
      "title": "Semantic Registry",
      "example": "Store global/customer with URI, SID annotations (domain=Customer, version=R20.0), lifecycle status."
    },
    "namespace": {
      "title": "Namespace Registry",
      "example": "global (TM Forum seed) · import-tmforum (staging) · natco-de (federated)."
    },
    "ontology": {
      "title": "Ontology & Taxonomy",
      "example": "customer specializes party-role; product realizedAs customer-facing-service (SID edges)."
    },
    "kg": {
      "title": "Knowledge Graph",
      "example": "Traverse Customer → owns → Account → linked Product → realizedAs → CFS."
    },
    "mapping": {
      "title": "Mapping Engine",
      "example": "Collibra 'Kunde' mapsTo global/customer; crm.customer represents global/customer."
    },
    "federation": {
      "title": "Federation Engine",
      "example": "natco-de/kunden sameAs global/customer for cross-NATCO reporting."
    },
    "governance": {
      "title": "Governance Engine",
      "example": "SID Customer: draft → review → approved before any active product bind."
    }
