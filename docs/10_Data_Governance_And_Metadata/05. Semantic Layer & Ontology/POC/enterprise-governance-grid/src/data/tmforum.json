  "governanceExample": {
    "concept": "global/customer",
    "sid": "Customer · Customer Party Roles ABE",
    "steps": [
      {
        "state": "draft",
        "actor": "Data Architecture",
        "action": "Import from SID into import-tmforum; promote stub to global"
      },
      {
        "state": "review",
        "actor": "Global Customer steward",
        "action": "Submit for COE approval with SID annotations"
      },
      {
        "state": "approved",
        "actor": "Global Semantic Council",
        "action": "Approve — valid target for maps and product binds"
      },
      {
        "state": "deprecated",
        "actor": "COE",
        "action": "Only with replaced_by + NATCO notification SLA"
      }
    ]
  },
