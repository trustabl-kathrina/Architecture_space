# =============================================================================
# KEW — Monorepo Environment Variables
# Copy to Architecture_space/.env (this file is gitignored)
# =============================================================================

# --- AI (Cursor SDK for chat; Gemini optional for doc factory) ---------------

# CURSOR_API_KEY=              # https://cursor.com/dashboard/integrations
# KEW_API_AI_PROVIDER=auto     # auto | cursor | gemini
# KEW_API_AI_MOCK_MODE=true    # offline dev without any API key

# GEMINI_API_KEY=              # optional; used when provider=gemini

# --- API (KEW_API_ prefix) ---------------------------------------------------

KEW_API_ENVIRONMENT=development
KEW_API_HOST=127.0.0.1
KEW_API_PORT=8000
KEW_API_RELOAD=true
KEW_API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
KEW_API_LOG_LEVEL=INFO

# --- Paths (optional — defaults resolve from monorepo root) ------------------

# KEW_API_REPO_ROOT=
# KEW_API_DOCS_ROOT=
# KEW_API_DATA_ROOT=

# --- Documentation AI Factory (CLI engine) -------------------------------------

# TAVILY_API_KEY=
# DOC_FACTORY_REPO_ROOT=

# --- Frontend (apps/workbench/.env — or set here for reference) --------------

# VITE_API_BASE_URL=/api/v1
# VITE_APP_NAME=KEW
