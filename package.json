{
  "name": "kew",
  "private": true,
  "version": "0.1.0",
  "description": "Architecture Space monorepo — KEW workbench + documentation engine",
  "scripts": {
    "setup": "deployment\\scripts\\setup.cmd",
    "dev": "pnpm --filter @kew/workbench dev",
    "dev:web": "deployment\\scripts\\dev-web.cmd",
    "dev:api": "deployment\\scripts\\dev-api.cmd",
    "dev:all": "start deployment\\scripts\\dev-api.cmd && deployment\\scripts\\dev-web.cmd",
    "build": "pnpm --filter @kew/workbench build",
    "lint": "pnpm --filter @kew/workbench lint",
    "typecheck": "pnpm --filter @kew/workbench typecheck",
    "preview": "pnpm --filter @kew/workbench preview",
    "test:api": "deployment\\scripts\\test-api.cmd"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
